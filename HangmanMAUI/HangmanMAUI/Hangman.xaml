<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HangmanMAUI.Hangman"
             Title="Hangman">
    <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="auto,*" Margin="10" ColumnSpacing="10">
        <Button Text="Start" Grid.Column="0" Grid.Row="0"/>
        <Button Text="New Word" Grid.Column="1" Grid.Row="0"/>
        <Button Text="Guess A Letter" Grid.Column="2" Grid.Row="0"/>
        <Button Text="Score:" Grid.Column="3" Grid.Row="0"/>
        <Image Source="gallows_pic_one.PNG" HeightRequest="500" Grid.Column="0" Grid.Row="1"/>
        <Grid Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="*" RowDefinitions="*,3*,*,3*" Margin="20">
            <Label Text="Word Display" Grid.Row="0" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
            <HorizontalStackLayout Grid.Row="1" VerticalOptions="End" Spacing="30" Margin="15">
                <Label Text="_"/>
                <Label Text="A"/>
                <Label Text="_"/>
                <Label Text="_"/>
                <Label Text="_"/>
                <Label Text="_"/>
                <Label Text="_"/>
            </HorizontalStackLayout>
            <Label Text="PADR" Grid.Row="2" HorizontalTextAlignment="Center"/>
            <Grid Grid.Row="3" ColumnDefinitions="*,*,*,*,*,*,*,*,*" RowDefinitions="*,*,*" ColumnSpacing="5" RowSpacing="5">
                <Button Text="A" Grid.Column="1" Grid.Row="0" Style="{StaticResource Key=letter-guessed}"/>
                <Button Text="B" Grid.Column="2" Grid.Row="0"/>
                <Button Text="C" Grid.Column="3" Grid.Row="0"/>
                <Button Text="D" Grid.Column="4" Grid.Row="0" Style="{StaticResource Key=letter-guessed}"/>
                <Button Text="E" Grid.Column="5" Grid.Row="0"/>
                <Button Text="F" Grid.Column="6" Grid.Row="0"/>
                <Button Text="G" Grid.Column="7" Grid.Row="0"/>
                <Button Text="H" Grid.Column="8" Grid.Row="0"/>
                <Button Text="I" Grid.Column="0" Grid.Row="1"/>
                <Button Text="J" Grid.Column="1" Grid.Row="1"/>
                <Button Text="K" Grid.Column="2" Grid.Row="1"/>
                <Button Text="L" Grid.Column="3" Grid.Row="1"/>
                <Button Text="M" Grid.Column="4" Grid.Row="1"/>
                <Button Text="N" Grid.Column="5" Grid.Row="1"/>
                <Button Text="O" Grid.Column="6" Grid.Row="1"/>
                <Button Text="P" Grid.Column="7" Grid.Row="1" Style="{StaticResource Key=letter-guessed}"/>
                <Button Text="Q" Grid.Column="8" Grid.Row="1"/>
                <Button Text="R" Grid.Column="0" Grid.Row="2" Style="{StaticResource Key=letter-guessed}"/>
                <Button Text="S" Grid.Column="1" Grid.Row="2"/>
                <Button Text="T" Grid.Column="2" Grid.Row="2"/>
                <Button Text="U" Grid.Column="3" Grid.Row="2"/>
                <Button Text="V" Grid.Column="4" Grid.Row="2"/>
                <Button Text="W" Grid.Column="5" Grid.Row="2"/>
                <Button Text="X" Grid.Column="6" Grid.Row="2"/>
                <Button Text="Y" Grid.Column="7" Grid.Row="2"/>
                <Button Text="Z" Grid.Column="8" Grid.Row="2"/>
            </Grid>
        </Grid>
    </Grid>

</ContentPage>